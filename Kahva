<!doctype html>
<html lang="bs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>Kahva sa Sanelom ☕️</title>

<style>
*{box-sizing:border-box}

html,body{
    margin:0;
    width:100%;
    height:100%;
    overflow:hidden;
}

body{
    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",sans-serif;
    color:#fff;
    background:
        radial-gradient(
            circle at 50% 25%,
            #52648d,
            #273555 42%,
            #0a1025 90%
        );
    display:flex;
    align-items:center;
    justify-content:center;
}

/* ZVIJEZDE */

#sky{
    position:fixed;
    inset:0;
}

.star{
    position:absolute;
    width:3px;
    height:3px;
    border-radius:50%;
    background:#fff;
    box-shadow:0 0 8px #fff;
    animation:twinkle 3s ease-in-out infinite;
}

@keyframes twinkle{
    0%,100%{
        opacity:.15;
        transform:scale(.6);
    }

    50%{
        opacity:1;
        transform:scale(1.7);
    }
}


/* MJESEC */

.moon{
    position:absolute;
    width:125px;
    height:125px;
    border-radius:50%;
    right:-35px;
    top:7%;

    background:#fff1b4;

    box-shadow:
        0 0 45px rgba(255,239,170,.65);

    animation:
        moon 4s cubic-bezier(.2,.8,.2,1) forwards;
}

.moon:after{
    content:"";

    position:absolute;

    width:125px;
    height:125px;

    border-radius:50%;

    left:35px;
    top:-12px;

    background:#182241;
}

@keyframes moon{

    from{
        transform:
            translate(100px,90px);

        opacity:0;
    }

    to{
        transform:
            translate(-28px,0);

        opacity:1;
    }
}


/* GLAVNA KARTICA */

.card{
    position:relative;
    z-index:5;

    width:min(91vw,440px);

    padding:34px 24px 30px;

    text-align:center;

    border-radius:34px;

    background:
        rgba(8,14,34,.42);

    border:
        1px solid rgba(255,255,255,.14);

    backdrop-filter:blur(20px);

    box-shadow:
        0 25px 80px rgba(0,0,0,.3);

    animation:
        cardIn 1s ease-out;
}

@keyframes cardIn{

    from{
        opacity:0;
        transform:
            translateY(25px)
            scale(.96);
    }

    to{
        opacity:1;
        transform:none;
    }
}


/* KAHVA */

.coffee{
    height:130px;

    position:relative;

    margin-bottom:4px;
}

.cup{

    position:absolute;

    left:50%;
    bottom:5px;

    transform:
        translateX(-50%);

    width:110px;
    height:70px;

    border-radius:
        12px 12px 42px 42px;

    background:
        linear-gradient(
            #f5d7b0,
            #bd8051
        );

    box-shadow:
        0 15px 28px rgba(0,0,0,.28);

    animation:
        cup 1s .4s both;
}

.cup:before{

    content:"";

    position:absolute;

    left:0;
    top:-9px;

    width:110px;
    height:28px;

    border-radius:50%;

    background:#593620;
}

.handle{

    position:absolute;

    right:-31px;
    top:16px;

    width:40px;
    height:43px;

    border:
        9px solid #d5a178;

    border-left:0;

    border-radius:
        0 25px 25px 0;
}

.steam{

    position:absolute;

    bottom:68px;

    width:5px;
    height:48px;

    border-radius:50%;

    background:
        rgba(255,255,255,.38);

    filter:blur(2px);

    animation:
        steam 2.6s ease-in-out infinite;
}

.s1{
    left:calc(50% - 34px);
}

.s2{
    left:50%;
    animation-delay:.7s;
}

.s3{
    left:calc(50% + 27px);
    animation-delay:1.4s;
}

@keyframes steam{

    0%{
        transform:
            translateY(10px)
            scale(.7);

        opacity:0;
    }

    35%{
        opacity:.65;
    }

    100%{
        transform:
            translateY(-34px)
            scale(1.4);

        opacity:0;
    }
}

@keyframes cup{

    from{
        opacity:0;

        transform:
            translateX(-50%)
            translateY(25px)
            scale(.75);
    }

    to{
        opacity:1;

        transform:
            translateX(-50%)
            translateY(0)
            scale(1);
    }
}


/* UVOD */

.intro{

    font-size:17px;

    color:
        rgba(255,255,255,.7);

    letter-spacing:1px;

    opacity:0;

    animation:
        fade 1s 1.6s forwards;
}


/* IME */

.name{

    font-size:
        clamp(40px,10vw,56px);

    font-weight:700;

    letter-spacing:-2px;

    margin:
        5px 0 15px;

    opacity:0;

    animation:
        up 1s 1.9s forwards,
        glow 3s 3s ease-in-out infinite;
}

@keyframes fade{

    to{
        opacity:1;
    }
}

@keyframes up{

    from{
        opacity:0;
        transform:
            translateY(15px);
    }

    to{
        opacity:1;
        transform:none;
    }
}

@keyframes glow{

    0%,100%{
        text-shadow:
            0 0 0
            rgba(255,239,180,0);
    }

    50%{
        text-shadow:
            0 0 25px
            rgba(255,239,180,.75);
    }
}


/* PITANJE */

.question{

    font-size:
        clamp(25px,6.5vw,35px);

    line-height:1.25;

    font-weight:650;

    min-height:92px;

    margin-top:5px;
}


/* POJAVLJIVANJE SLOVA */

.letter{

    display:inline-block;

    opacity:0;

    transform:
        translateY(14px);

    animation:
        letter .42s ease forwards;
}

@keyframes letter{

    to{
        opacity:1;

        transform:
            translateY(0);
